{
  "type": "object",
  "required": [
    "code_quality_report",
    "technical_debt_assessment"
  ],
  "properties": {
    "code_quality_report": {
      "type": "object",
      "required": ["overall_score", "findings"],
      "properties": {
        "overall_score": { "type": "number" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "severity", "description", "file", "line"],
            "properties": {
              "category": { "type": "string" },
              "severity": { "type": "string" },
              "description": { "type": "string" },
              "file": { "type": "string" },
              "line": { "type": "number" },
              "recommendation": { "type": "string" }
            }
          }
        }
      }
    },
    "technical_debt_assessment": {
      "type": "object",
      "required": ["debt_ratio", "items"],
      "properties": {
        "debt_ratio": { "type": "number" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["area", "impact", "effort", "priority"],
            "properties": {
              "area": { "type": "string" },
              "impact": { "type": "string" },
              "effort": { "type": "string" },
              "priority": { "type": "string" }
            }
          }
        }
      }
    },
    "security_vulnerabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cve_id", "severity", "description", "fix"],
        "properties": {
          "cve_id": { "type": "string" },
          "severity": { "type": "string" },
          "description": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    },
    "refactoring_suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
